# Quiz grading via OpenRouter (pinned open-weight model + fallback).
OPENROUTER_API_KEY=
UNHYPED_GRADER_MODEL=
UNHYPED_GRADER_FALLBACK=
# Optional: point at a free router (e.g. a local FreeLLMAPI) in development only.
# OPENROUTER_BASE_URL=http://localhost:8787/v1/chat/completions

# Budget guard
UNHYPED_CALLS_PER_SESSION=30
UNHYPED_CALLS_PER_IP_HOUR=120
UNHYPED_DAILY_CALL_CAP=5000

# Ingestion (admin only)
UNHYPED_ADMIN_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=owner/unhyped
GITHUB_BASE_BRANCH=main
