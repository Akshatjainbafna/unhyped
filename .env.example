# Quiz grading via OpenRouter (pinned open-weight model + fallback).
OPENROUTER_API_KEY=
UNHYPED_GRADER_MODEL=
UNHYPED_GRADER_FALLBACK=
# Optional: point at a free router (e.g. a local FreeLLMAPI) in development only.
# OPENROUTER_BASE_URL=http://localhost:8787/v1/chat/completions

# Budget guard
UNHYPED_CALLS_PER_SESSION=30
UNHYPED_CALLS_PER_IP_HOUR=120
UNHYPED_DAILY_CALL_CAP=5000

# Ingestion (admin only). The admin token is the sign-in secret: use a long random string
# (openssl rand -base64 32). Rotating it signs every session out.
# Research uses a stronger model when set; otherwise the grader model. Any OpenRouter model id.
UNHYPED_RESEARCH_MODEL=
UNHYPED_ADMIN_TOKEN=
# Fine-grained token, this repo only: Contents and Pull requests read/write.
GITHUB_TOKEN=
GITHUB_REPO=owner/unhyped
GITHUB_BASE_BRANCH=main
